{
  "name": "cloud-sg-sync",
  "version": "1.0.0",
  "description": "云安全组公网 IP 同步（当前支持阿里云）",
  "license": "MIT",
  "author": "zhangyanfeng2015",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhangyanfeng2015/cloud-sg-sync.git"
  },
  "bugs": {
    "url": "https://github.com/zhangyanfeng2015/cloud-sg-sync/issues"
  },
  "homepage": "https://github.com/zhangyanfeng2015/cloud-sg-sync#readme",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "cargo:clean": "cargo clean --manifest-path src-tauri/Cargo.toml",
    "icons:gen:app": "tauri icon src-tauri/icons/source/app-icon.svg -o src-tauri/icons",
    "icons:gen:tray": "tauri icon src-tauri/icons/source/tray-icon.svg -o src-tauri/icons/tray-out && node scripts/copy-tray-ico.mjs",
    "icons:gen": "pnpm run icons:gen:app && pnpm run icons:gen:tray"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "~2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "element-plus": "^2.9.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^5.2.1",
    "sass": "^1.83.0",
    "typescript": "~5.6.2",
    "unplugin-auto-import": "^19.0.0",
    "unplugin-vue-components": "^28.0.0",
    "vite": "^6.0.3"
  }
}
